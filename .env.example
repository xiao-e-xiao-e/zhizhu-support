# ===== LLM（对话生成，需要远程 API）=====
API_BASE_URL=https://api.deepseek.com
API_KEY=your_api_key_here
CHAT_MODEL=deepseek-v4-flash
MAX_TOKENS=1024

# ===== 嵌入模型（本地运行，无需 API Key）=====
# BAAI/bge-small-zh-v1.5：中文语义向量，512 维，约 95MB，首次使用自动下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== RAG 默认参数（前端可逐次覆盖）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
TEMPERATURE=0.3
SIMILARITY_THRESHOLD=0.0

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000

# ===== 业务数据库与身份 =====
# 本地留空使用 backend/storage/app.db；生产使用 postgresql+psycopg://...
# DATABASE_URL=postgresql+psycopg://support:password@127.0.0.1:5432/support
APP_ENV=development
COOKIE_SECURE=false
SESSION_HOURS=12
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
WARMUP_ON_STARTUP=true
MAX_UPLOAD_MB=20

# M3 原生开发：先启动 chroma run --path ../chroma_db --port 8001
# 再给 API 和 worker 使用相同配置；Compose 已自动连接内部 Chroma 服务。
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8001
# DOCUMENT_STORAGE_DIR=/absolute/path/to/zhizhu-support/backend/storage/documents
QUERY_REWRITE_ENABLED=true
REWRITE_MAX_TOKENS=160
DEEPSEEK_THINKING=false
JOB_LEASE_SECONDS=120

# M4 单次助手运行边界；FAQ 生成同样受模型调用超时和输出预算约束。
AGENT_MAX_STEPS=6
AGENT_MAX_ROUNDS=4
AGENT_TIMEOUT_SECONDS=60
AGENT_CALL_TIMEOUT_SECONDS=15
AGENT_TOKEN_BUDGET=16000

# 旧开发夹具开关，常规业务部署保持 false；不会提供公开账号入口。
DEMO_MODE=false

# Docker Compose 使用；请生成独立随机密码，建议用字母数字避免 URL 编码问题。
POSTGRES_PASSWORD=replace_with_a_random_database_password
WEB_PORT=8080
