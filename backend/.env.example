# ===== LLM（对话生成，需要远程 API）=====
API_BASE_URL=https://api.deepseek.com
API_KEY=your_api_key_here
CHAT_MODEL=deepseek-v4-flash
MAX_TOKENS=1024

# ===== 嵌入模型（本地运行，无需 API Key）=====
# BAAI/bge-small-zh-v1.5：中文语义向量，512 维，约 95MB，首次使用自动下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== RAG 默认参数（前端可逐次覆盖）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
TEMPERATURE=0.3
SIMILARITY_THRESHOLD=0.0

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
