# ===== LLM（对话生成，需要远程 API）=====
API_BASE_URL=https://api.deepseek.com
QUERY_REWRITE_ENABLED=true
DEEPSEEK_THINKING=false
# 原生开发需先运行 Chroma 服务，API 与 worker 使用相同配置。
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8001
API_KEY=your_api_key_here
CHAT_MODEL=deepseek-v4-flash
MAX_TOKENS=1024

# ===== 嵌入模型（本地运行，无需 API Key）=====
# BAAI/bge-small-zh-v1.5：中文语义向量，512 维，约 95MB，首次使用自动下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== RAG 默认参数（前端可逐次覆盖）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
TEMPERATURE=0.3
SIMILARITY_THRESHOLD=0.0

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000

# 本地 SQLite 自动使用 backend/storage/app.db；生产用 PostgreSQL。
# DATABASE_URL=postgresql+psycopg://support:password@127.0.0.1:5432/support
APP_ENV=development
COOKIE_SECURE=false
SESSION_HOURS=12
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WARMUP_ON_STARTUP=true
MAX_UPLOAD_MB=20
